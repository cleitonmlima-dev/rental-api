# Valores somente para desenvolvimento local.
NODE_ENV=development
PORT=3000

# A API usa o papel limitado; a CLI usa o migrator separadamente.
DATABASE_URL=postgresql://rental_app:rental_app_local@127.0.0.1:5432/rental
MIGRATION_DATABASE_URL=postgresql://rental_migrator:rental_migrator_local@127.0.0.1:5432/rental

# SNS/SQS locais; em AWS remova AWS_ENDPOINT_URL e use credenciais/role de execução.
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://127.0.0.1:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:rental-proposal-status
SNS_PUBLISH_TIMEOUT_MS=2000
LOCALSTACK_PORT=4566

DB_CONNECT_TIMEOUT_MS=1000
DB_LOCK_TIMEOUT_MS=1000
DB_STATEMENT_TIMEOUT_MS=3000
DB_OPERATION_TIMEOUT_MS=5000

# Bootstrap do PostgreSQL no Compose. Mudar credenciais exige ajustar as URLs.
POSTGRES_PASSWORD=postgres_local
MIGRATOR_DB_PASSWORD=rental_migrator_local
APP_DB_PASSWORD=rental_app_local
OBSERVER_DB_PASSWORD=rental_observer_local
POSTGRES_PORT=5432

# Exportação assíncrona; a indisponibilidade da stack não bloqueia o negócio.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SDK_DISABLED=false
GRAFANA_PASSWORD=grafana_local

# Banco temporário do perfil test; não usar o banco de desenvolvimento nos testes de negócio.
TEST_POSTGRES_PORT=15432
TEST_DATABASE_URL=postgresql://rental_app:rental_app_local@127.0.0.1:15432/rental_test
TEST_MIGRATION_DATABASE_URL=postgresql://rental_migrator:rental_migrator_local@127.0.0.1:15432/rental_test
TEST_OBSERVER_DATABASE_URL=postgresql://rental_observer:rental_observer_local@127.0.0.1:15432/rental_test
